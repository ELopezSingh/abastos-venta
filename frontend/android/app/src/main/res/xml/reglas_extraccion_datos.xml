<?xml version="1.0" encoding="utf-8"?>
<!--
  La tablet no se respalda ni se transfiere a otro dispositivo: su base SQLite
  restaurada traería folios atrasados y una cola vieja. Para reinstalar se usa
  GET /api/sync/snapshot.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
