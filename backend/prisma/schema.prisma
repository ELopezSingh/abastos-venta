generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum EstadoTrailer {
  ACTIVO
  CERRADO
}

enum EstadoTicket {
  VIGENTE
  CANCELADO
}

/// Trailer que llega al andén con mercancía de un invernadero.
model Trailer {
  /// UUID generado en la tablet al crear el trailer.
  id                 String        @id @default(uuid()) @db.Uuid
  /// Nombre del viaje (ej. HORTIFRESH-01). Opcional en la base solo porque
  /// los trailers registrados antes de agregar el campo no lo tienen.
  viaje              String?
  placa              String
  numero             String
  invernadero        String
  chofer             String
  anden              String
  /// En la hoja de Excel aparece como "Piso".
  costoAnden         Decimal       @map("costo_anden") @db.Decimal(12, 2)
  flete              Decimal       @default(0) @db.Decimal(12, 2)
  descarga           Decimal       @default(0) @db.Decimal(12, 2)
  /// Porcentaje de la venta que cobra el comercializador (10 = 10 %).
  comisionPorcentaje Decimal       @default(10) @map("comision_porcentaje") @db.Decimal(5, 2)
  fechaLlegada       DateTime      @default(now()) @map("fecha_llegada")
  fechaCierre        DateTime?     @map("fecha_cierre")
  estado             EstadoTrailer @default(ACTIVO)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  manifiesto ManifiestoDetalle[]

  @@index([fechaLlegada])
  @@index([estado, fechaCierre])
  @@map("trailers")
}

/// Cada producto/tamaño que trae el trailer. Las ventas apuntan aquí,
/// así se sabe de qué trailer salió cada caja y cuántas quedan.
model ManifiestoDetalle {
  id        String  @id @default(uuid()) @db.Uuid
  trailerId String  @map("trailer_id") @db.Uuid
  producto  String
  color     String?
  tamano    String
  cajas     Int

  trailer Trailer         @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  ventas  TicketDetalle[]

  @@index([trailerId])
  @@map("manifiesto_detalle")
}

model Ticket {
  id            String       @id @default(uuid()) @db.Uuid
  /// Folio consecutivo impreso en el ticket. Lo asigna la tablet; los tickets
  /// anteriores a la migración conservan su número original.
  folio         Int          @unique
  fecha         DateTime     @default(now())
  clienteNombre String       @map("cliente_nombre")
  total         Decimal      @db.Decimal(12, 2)
  estado        EstadoTicket @default(VIGENTE)
  createdAt     DateTime     @default(now()) @map("created_at")

  detalles TicketDetalle[]

  @@index([fecha])
  @@map("tickets")
}

model TicketDetalle {
  id                  String  @id @default(uuid()) @db.Uuid
  ticketId            String  @map("ticket_id") @db.Uuid
  manifiestoDetalleId String  @map("manifiesto_detalle_id") @db.Uuid
  cajas               Int
  precioCaja          Decimal @map("precio_caja") @db.Decimal(12, 2)
  subtotal            Decimal @db.Decimal(12, 2)

  ticket            Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  manifiestoDetalle ManifiestoDetalle @relation(fields: [manifiestoDetalleId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([manifiestoDetalleId])
  @@map("ticket_detalle")
}

/// Operaciones recibidas de la tablet. El id (UUID de la operación) hace que
/// un reintento no se aplique dos veces; seq da el orden de aplicación.
model OperacionSync {
  id         String   @id @db.Uuid
  seq        BigInt   @unique @default(autoincrement())
  tipo       String
  datos      Json
  /// Hora en que se hizo la acción en la tablet (puede ser horas antes si no había señal).
  creadaEn   DateTime @map("creada_en")
  aplicadaEn DateTime @default(now()) @map("aplicada_en")

  @@map("operaciones_sync")
}

model Usuario {
  id             Int      @id @default(autoincrement())
  usuario        String   @unique
  hashContrasena String   @map("hash_contrasena")
  creadoEn       DateTime @default(now()) @map("creado_en")
  sesiones       Sesion[]

  @@map("usuarios")
}

model Sesion {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  usuarioId Int      @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEn  DateTime @map("expira_en")
  creadoEn  DateTime @default(now()) @map("creado_en")

  @@index([usuarioId])
  @@map("sesiones")
}
